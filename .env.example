# Copy to .env. Never commit .env.

# Needed only for --grader judge, --tester adaptive, or --target claude.
ANTHROPIC_API_KEY=

# Model for every role. Defaults to claude-opus-5.
ICE_MODEL=
# Per-role overrides.
ICE_JUDGE_MODEL=
ICE_TESTER_MODEL=
ICE_TARGET_MODEL=

# Most turns an adaptive tester may take in one probe. Defaults to 6.
ICE_MAX_TURNS=

# Bearer token sent to an HTTP target, and seconds to wait for its reply.
ICE_TARGET_TOKEN=
ICE_TARGET_TIMEOUT=
